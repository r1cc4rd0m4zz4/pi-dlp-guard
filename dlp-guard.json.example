{
  "enabled": true,
  "protectedPaths": [
    ".env",
    ".env.*",
    "*.env",
    ".envrc",
    "**/.git/**",
    "~/.ssh/**",
    "/etc/ssh/**",
    "/etc/shadow*",
    "/etc/gshadow*",
    "/etc/sudoers*",
    "~/.aws/**",
    "~/.config/gcloud/**",
    "~/.gcp/**",
    "~/.azure/**",
    "~/.oci/**",
    "~/.gnupg/**",
    "~/.password-store/**",
    "~/.local/share/keyrings/**",
    "~/Library/Keychains/**",
    "~/.config/gh/**",
    "~/.config/glab-cli/**",
    "~/.config/op/**",
    "~/.op/**",
    "~/.config/sops/**",
    "~/.config/age/**",
    "~/.kube/**",
    "~/.docker/config.json",
    "~/.terraform.d/**",
    "**/*.tfstate",
    "**/*.tfstate.*",
    "**/*.tfvars",
    "~/.vault-token",
    "~/.netrc",
    "~/.git-credentials",
    "~/.npmrc",
    "~/.pypirc",
    "~/.gem/credentials",
    "~/.cargo/credentials*",
    "~/.composer/auth.json",
    "~/.zshrc*",
    "~/.zprofile",
    "~/.zshenv",
    "~/.zsh_history",
    "~/.bashrc*",
    "~/.bash_profile",
    "~/.bash_history",
    "~/.profile",
    "**/*rc.local",
    "**/*.pem",
    "**/*.key",
    "**/*.pkcs12",
    "**/*.pfx",
    "**/*.p12",
    "**/*.jks",
    "**/*.keystore",
    "**/*.age",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/id_ecdsa*",
    "**/id_dsa*",
    "~/.pi/agent/auth.json",
    "~/.claude/.credentials.json"
  ],
  "integrityPaths": [
    "~/.pi/agent/**",
    "**/.pi/agent/**",
    ".pi/**",
    "~/.gemini/config/**",
    "**/.gemini/config/**",
    "~/.gemini/antigravity-cli/**",
    "~/.gemini/antigravity/**",
    "~/.gemini/antigravity-ide/**",
    ".agents/**",
    ".agent/**",
    "_agents/**",
    "_agent/**",
    "**/dlp-guard.json"
  ],
  "enableGitleaks": true,
  "gitleaksMinBytes": 4096,
  "gitleaksTimeoutMs": 500,
  "blockInlineSecretsInCommands": true,
  "blockReaderCommandsOnProtected": true,
  "blockWriteSecrets": true
}
